{
  "model_name": "Random Forest",
  "model_version": "3.1",
  "accuracy": 0.9813,
  "features": [
    "income",
    "loan_amount",
    "loan_to_income",
    "cibil_score"
  ],
  "target": "risk_level",
  "dataset": "Loan Approval Prediction Dataset",
  "report_file": "model_report.txt",
  "heavy_loan_to_income_threshold": 3.348,
  "very_heavy_loan_to_income_threshold": 3.805,
  "feature_ranges": {
    "income": [
      200000.0,
      9900000.0
    ],
    "loan_amount": [
      300000.0,
      39500000.0
    ],
    "loan_to_income": [
      1.5,
      4.0
    ],
    "cibil_score": [
      300.0,
      900.0
    ]
  },
  "label_rules": "Rejected = High; otherwise +1 if cibil < 700, +1 if loan_to_income >= heavy threshold, +2 if >= very heavy threshold (0 Low, 1 Medium, 2+ High)"
}